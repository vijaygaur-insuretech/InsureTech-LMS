{{!
    @template theme_insuretech/public_footer

    Footer of the public pages: about, quick links, contact and social links.

    Example context (json):
    { "homeurl": "#", "loginurl": "#", "brandname": "insureTech Skills", "footerabout": "Training.",
      "email": "a@b.c", "phone": "+91", "phonelink": "+91", "address": "Dehradun", "socials": [], "year": 2026 }
}}
<footer class="it-pub-footer" id="contact">
    <div class="it-pub-container it-pub-footer-grid">
        <div class="it-pub-footer-brand">
            <img src="{{logolighturl}}" alt="{{brandname}}" class="it-pub-footer-logo" width="160" height="43">
            <p class="it-pub-footer-about">{{footerabout}}</p>
            {{#hassocials}}
                <div class="it-pub-socials">
                    {{#socials}}
                        <a href="{{url}}" target="_blank" rel="noopener noreferrer" aria-label="{{label}}"><i class="icon fa-brands {{icon}} m-0" aria-hidden="true"></i></a>
                    {{/socials}}
                </div>
            {{/hassocials}}
        </div>
        <div>
            <h2 class="it-pub-footer-title">{{#str}}navcourses, theme_insuretech{{/str}}</h2>
            <ul class="it-pub-footer-links">
                <li><a href="{{homeurl}}#live">{{#str}}typelive, theme_insuretech{{/str}}</a></li>
                <li><a href="{{homeurl}}#selfpaced">{{#str}}typeselfpaced, theme_insuretech{{/str}}</a></li>
                <li><a href="{{homeurl}}#courses">{{#str}}viewallcourses, theme_insuretech{{/str}}</a></li>
                <li><a href="{{loginurl}}">{{#str}}login{{/str}}</a></li>
            </ul>
        </div>
        <div>
            <h2 class="it-pub-footer-title">{{#str}}quicklinks, theme_insuretech{{/str}}</h2>
            <ul class="it-pub-footer-links">
                <li><a href="{{homeurl}}#how">{{#str}}navhow, theme_insuretech{{/str}}</a></li>
                <li><a href="{{homeurl}}#about">{{#str}}navabout, theme_insuretech{{/str}}</a></li>
                <li><a href="{{homeurl}}#faq">{{#str}}navfaq, theme_insuretech{{/str}}</a></li>
                {{#websiteurl}}<li><a href="{{websiteurl}}">{{#str}}mainwebsite, theme_insuretech{{/str}}</a></li>{{/websiteurl}}
            </ul>
        </div>
        <div>
            <h2 class="it-pub-footer-title">{{#str}}navcontact, theme_insuretech{{/str}}</h2>
            <ul class="it-pub-footer-links it-pub-contact">
                {{#email}}<li><i class="icon fa fa-envelope" aria-hidden="true"></i><a href="mailto:{{email}}">{{email}}</a></li>{{/email}}
                {{#phone}}<li><i class="icon fa fa-phone" aria-hidden="true"></i><a href="tel:{{phonelink}}">{{phone}}</a></li>{{/phone}}
                {{#address}}<li><i class="icon fa fa-location-dot" aria-hidden="true"></i><span>{{address}}</span></li>{{/address}}
            </ul>
        </div>
    </div>
    <div class="it-pub-footer-bottom">
        <div class="it-pub-container it-pub-footer-bottom-inner">
            <span>&copy; {{year}} {{brandname}}. {{#str}}allrightsreserved, theme_insuretech{{/str}}</span>
            {{#haslegal}}
                <nav class="it-pub-legal" aria-label="{{#str}}quicklinks, theme_insuretech{{/str}}">
                    {{#privacyurl}}<a href="{{privacyurl}}">{{#str}}privacypolicy, theme_insuretech{{/str}}</a>{{/privacyurl}}
                    {{#termsurl}}<a href="{{termsurl}}">{{#str}}termslink, theme_insuretech{{/str}}</a>{{/termsurl}}
                    {{#refundurl}}<a href="{{refundurl}}">{{#str}}refundpolicy, theme_insuretech{{/str}}</a>{{/refundurl}}
                </nav>
            {{/haslegal}}
        </div>
    </div>
</footer>
