{{!
    @template theme_insuretech/sidenav

    Learner sidebar (left column on wide screens, bottom tab bar on phones).

    Example context (json):
    { "items": [{"url": "#", "icon": "fa-gauge-high", "label": "Dashboard", "active": true}] }
}}
<nav class="it-sidenav d-print-none" aria-label="{{#str}}nav_learning, theme_insuretech{{/str}}">
    <ul>
        {{#items}}
            <li>
                <a href="{{url}}" class="it-sidenav-link{{#active}} active{{/active}}"{{#active}} aria-current="page"{{/active}}>
                    <i class="icon fa {{icon}} m-0" aria-hidden="true"></i>
                    <span>{{label}}</span>
                </a>
            </li>
        {{/items}}
    </ul>
</nav>
