{{!
    @template theme_insuretech/manage_people

    Students & trainers list.

    Example context (json):
    {
        "tabs": [{"label": "Students", "count": 4, "url": "#", "active": true}],
        "type": "student", "search": "", "formurl": "#", "addurl": "#", "classesurl": "#",
        "rows": [{"picture": "", "name": "Priya Sharma", "email": "p@example.com", "lastaccess": "2 hours",
            "courses": [{"course": "AWS", "batches": "Batch A", "status": "active", "statuslabel": "Active"}],
            "hascourses": true, "manageurl": "#"}],
        "hasrows": true, "paging": ""
    }
}}
<div class="it-manage">
    <div class="it-manage-toolbar">
        <nav class="it-tabs" aria-label="{{#str}}managepeople, theme_insuretech{{/str}}">
            {{#tabs}}
                <a href="{{url}}" class="it-tab {{#active}}active{{/active}}" {{#active}}aria-current="page"{{/active}}>
                    {{label}} <span class="it-tab-count">{{count}}</span>
                </a>
            {{/tabs}}
        </nav>
        <div class="it-manage-actions">
            <a href="{{classesurl}}" class="btn btn-outline-secondary"><i class="icon fa fa-layer-group" aria-hidden="true"></i>{{#str}}manageclasses, theme_insuretech{{/str}}</a>
            <a href="{{addurl}}" class="btn btn-primary"><i class="icon fa fa-user-plus" aria-hidden="true"></i>{{#str}}addperson, theme_insuretech{{/str}}</a>
        </div>
    </div>

    <form method="get" action="{{formurl}}" class="it-search mb-3" role="search">
        <input type="hidden" name="type" value="{{type}}">
        <label for="it-people-search" class="visually-hidden">{{#str}}search{{/str}}</label>
        <input type="search" id="it-people-search" name="search" value="{{search}}" class="form-control"
               placeholder="{{#str}}searchpeople, theme_insuretech{{/str}}">
        <button type="submit" class="btn btn-secondary">{{#str}}search{{/str}}</button>
    </form>

    {{#hasrows}}
        <div class="it-card p-0">
            <div class="table-responsive">
                <table class="table it-table mb-0">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}}name{{/str}}</th>
                            <th scope="col">{{#str}}coursesandbatches, theme_insuretech{{/str}}</th>
                            <th scope="col">{{#str}}lastaccess{{/str}}</th>
                            <th scope="col"><span class="visually-hidden">{{#str}}actions{{/str}}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                            <tr>
                                <td>
                                    <div class="it-person">
                                        {{{picture}}}
                                        <div>
                                            <a href="{{manageurl}}" class="it-person-name">{{name}}</a>
                                            {{#suspended}}<span class="it-pill it-pill-danger">{{#str}}suspended{{/str}}</span>{{/suspended}}
                                            <span class="it-person-email">{{email}}</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    {{#courses}}
                                        <div class="it-assign-chip">
                                            <span class="it-assign-course">{{course}}</span>
                                            {{#istrainer}}<span class="it-pill">{{#str}}trainer, theme_insuretech{{/str}}</span>{{/istrainer}}
                                            {{#batches}}<span class="it-pill">{{batches}}</span>{{/batches}}
                                            {{#showstatus}}<span class="it-status it-status-{{status}}">{{statuslabel}}</span>{{/showstatus}}
                                        </div>
                                    {{/courses}}
                                    {{^hascourses}}<span class="text-muted">{{#str}}notassigned, theme_insuretech{{/str}}</span>{{/hascourses}}
                                </td>
                                <td class="text-nowrap text-muted">{{lastaccess}}</td>
                                <td class="text-end">
                                    <a href="{{manageurl}}" class="btn btn-sm btn-outline-primary text-nowrap">{{#str}}manage, theme_insuretech{{/str}}</a>
                                </td>
                            </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>
        </div>
        {{{paging}}}
    {{/hasrows}}
    {{^hasrows}}
        <div class="it-card it-empty">{{#str}}nopeople, theme_insuretech{{/str}}</div>
    {{/hasrows}}
</div>
