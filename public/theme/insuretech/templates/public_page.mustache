{{!
    @template theme_insuretech/public_page

    Public page shell: landing header and footer around the page content.

    Example context (json):
    { "output": { "doctype": "<!DOCTYPE html>", "page_title": "Course", "favicon": "", "main_content": "<p>Content</p>" },
      "bodyattributes": "", "homeurl": "#", "loginurl": "#" }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="it-public">
    {{{ output.standard_top_of_body_html }}}
    {{> theme_insuretech/public_header }}
    <div id="page" class="it-pub-main">
        <div class="it-pub-container">
            {{{ output.main_content }}}
        </div>
    </div>
    {{> theme_insuretech/public_footer }}
    {{{ output.standard_end_of_body_html }}}
</div>
</body>
</html>
