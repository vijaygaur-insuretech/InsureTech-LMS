{{!
    @template theme_insuretech/manage_classes

    Classes & batches: live class links for every course and batch.

    Example context (json):
    {
        "isadmin": true, "search": "", "formurl": "#", "peopleurl": "#", "sesskey": "x", "summary": "4 courses",
        "courses": [{"id": 2, "name": "AWS", "courseurl": "#", "trainers": "Rahul Verma", "hastrainers": true,
            "learnerstext": "4 learners", "link": "https://meet.google.com/x", "schedule": "Mon-Fri 7 PM", "haslink": true,
            "batches": [{"id": 1, "courseid": 2, "name": "Batch A", "members": 5, "link": "", "schedule": "", "membersurl": "#"}],
            "hasbatches": true, "canbatch": true}],
        "hascourses": true
    }
}}
<div class="it-manage">
    <div class="it-manage-toolbar">
        <p class="text-muted mb-0">{{summary}}</p>
        <div class="it-manage-actions">
            {{#isadmin}}
                <a href="{{peopleurl}}" class="btn btn-outline-secondary"><i class="icon fa fa-users" aria-hidden="true"></i>{{#str}}managepeople, theme_insuretech{{/str}}</a>
            {{/isadmin}}
        </div>
    </div>

    <form method="get" action="{{formurl}}" class="it-search mb-3" role="search">
        <label for="it-class-search" class="visually-hidden">{{#str}}search{{/str}}</label>
        <input type="search" id="it-class-search" name="search" value="{{search}}" class="form-control"
               placeholder="{{#str}}searchcourses, theme_insuretech{{/str}}">
        <button type="submit" class="btn btn-secondary">{{#str}}search{{/str}}</button>
    </form>

    {{#courses}}
        <section class="it-card it-class mb-3" id="course-{{id}}" aria-labelledby="course-{{id}}-title">
            <div class="it-class-head">
                <div>
                    <h3 class="it-class-title" id="course-{{id}}-title"><a href="{{courseurl}}">{{name}}</a>
                        {{#hidden}}<span class="it-pill">{{#str}}hidden{{/str}}</span>{{/hidden}}
                    </h3>
                    <p class="it-teach-meta mb-0">
                        <i class="icon fa fa-chalkboard-user" aria-hidden="true"></i>
                        {{#hastrainers}}{{trainers}}{{/hastrainers}}{{^hastrainers}}<span class="text-muted">{{#str}}notrainer, theme_insuretech{{/str}}</span>{{/hastrainers}}
                        <span class="it-dot" aria-hidden="true">·</span>
                        <i class="icon fa fa-users" aria-hidden="true"></i>{{learnerstext}}
                    </p>
                </div>
                {{#haslink}}
                    <a href="{{link}}" class="btn btn-sm it-btn-live" target="_blank" rel="noopener noreferrer"><span class="it-live-dot" aria-hidden="true"></span>{{#str}}joinclass, theme_insuretech{{/str}}</a>
                {{/haslink}}
            </div>

            <form method="post" action="{{formurl}}" class="it-link-form">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="savecourse">
                <input type="hidden" name="courseid" value="{{id}}">
                <span class="it-link-form-label">{{#str}}coursedefault, theme_insuretech{{/str}}</span>
                <label class="visually-hidden" for="link-{{id}}">{{#str}}liveclasslink, theme_insuretech{{/str}}</label>
                <input type="url" name="link" id="link-{{id}}" value="{{link}}" class="form-control form-control-sm"
                       placeholder="https://meet.google.com/…">
                <label class="visually-hidden" for="schedule-{{id}}">{{#str}}liveclassschedule, theme_insuretech{{/str}}</label>
                <input type="text" name="schedule" id="schedule-{{id}}" value="{{schedule}}" class="form-control form-control-sm"
                       placeholder="{{#str}}scheduleplaceholder, theme_insuretech{{/str}}">
                <button type="submit" class="btn btn-sm btn-primary">{{#str}}save{{/str}}</button>
            </form>

            {{#hasbatches}}
                <div class="it-batches">
                    {{#batches}}
                        <form method="post" action="{{formurl}}" class="it-link-form it-link-form-batch">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" name="action" value="savebatch">
                            <input type="hidden" name="courseid" value="{{courseid}}">
                            <input type="hidden" name="groupid" value="{{id}}">
                            <span class="it-link-form-label">
                                <i class="icon fa fa-layer-group" aria-hidden="true"></i>{{name}}
                                <a href="{{membersurl}}" class="it-batch-members">{{#str}}memberscount, theme_insuretech, {{members}}{{/str}}</a>
                                {{#dates}}<span class="it-batch-members">{{dates}}</span>{{/dates}}
                            </span>
                            <label class="visually-hidden" for="blink-{{id}}">{{#str}}liveclasslink, theme_insuretech{{/str}}: {{name}}</label>
                            <input type="url" name="link" id="blink-{{id}}" value="{{link}}" class="form-control form-control-sm"
                                   placeholder="{{#str}}batchlinkplaceholder, theme_insuretech{{/str}}">
                            <label class="visually-hidden" for="bschedule-{{id}}">{{#str}}liveclassschedule, theme_insuretech{{/str}}: {{name}}</label>
                            <input type="text" name="schedule" id="bschedule-{{id}}" value="{{schedule}}" class="form-control form-control-sm"
                                   placeholder="{{#str}}scheduleplaceholder, theme_insuretech{{/str}}">
                            <button type="submit" class="btn btn-sm btn-outline-primary">{{#str}}save{{/str}}</button>
                        </form>
                    {{/batches}}
                </div>
            {{/hasbatches}}

            {{#canbatch}}
                <form method="post" action="{{formurl}}" class="it-inline-form mt-3">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="addbatch">
                    <input type="hidden" name="courseid" value="{{id}}">
                    <label class="visually-hidden" for="newbatch-{{id}}">{{#str}}newbatchname, theme_insuretech{{/str}}</label>
                    <input type="text" name="name" id="newbatch-{{id}}" class="form-control form-control-sm"
                           placeholder="{{#str}}newbatchname, theme_insuretech{{/str}}" required>
                    <label class="visually-hidden" for="bstart-{{id}}">{{#str}}batchstart, theme_insuretech{{/str}}</label>
                    <input type="date" name="start" id="bstart-{{id}}" class="form-control form-control-sm it-date" title="{{#str}}batchstart, theme_insuretech{{/str}}">
                    <label class="visually-hidden" for="bend-{{id}}">{{#str}}batchend, theme_insuretech{{/str}}</label>
                    <input type="date" name="end" id="bend-{{id}}" class="form-control form-control-sm it-date" title="{{#str}}batchend, theme_insuretech{{/str}}">
                    <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="icon fa fa-plus" aria-hidden="true"></i>{{#str}}addbatch, theme_insuretech{{/str}}</button>
                </form>
            {{/canbatch}}
        </section>
    {{/courses}}
    {{^hascourses}}
        <div class="it-card it-empty">{{#str}}nocourses{{/str}}</div>
    {{/hascourses}}
</div>
