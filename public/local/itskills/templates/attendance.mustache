{{!
    @template local_itskills/attendance

    Take attendance.

    Example context (json):
    { "title": "Class 1", "date": "Mon", "actionurl": "#", "sesskey": "x", "rows": [], "hasrows": false, "backurl": "#" }
}}
<div class="its">
    <div class="its-head">
        <div>
            <h2 class="its-title">{{#str}}takeattendance, local_itskills{{/str}}</h2>
            <p class="its-muted mb-0">{{title}} · {{date}}</p>
        </div>
        <a href="{{backurl}}" class="btn btn-outline-secondary">{{#str}}back{{/str}}</a>
    </div>
    {{#hasrows}}
        <form method="post" action="{{actionurl}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <div class="its-card p-0">
                <table class="table mb-0 its-table">
                    <thead><tr><th>{{#str}}learner, local_itskills{{/str}}</th><th>{{#str}}status, local_itskills{{/str}}</th><th>{{#str}}attendance, local_itskills{{/str}}</th></tr></thead>
                    <tbody>
                        {{#rows}}
                            <tr>
                                <td><span class="its-person">{{{picture}}}{{name}}</span></td>
                                <td>
                                    <div class="its-seg" role="radiogroup" aria-label="{{name}}">
                                        {{#options}}
                                            <label class="its-seg-{{value}}"><input type="radio" name="status_{{id}}" value="{{value}}" {{#checked}}checked{{/checked}}><span>{{label}}</span></label>
                                        {{/options}}
                                    </div>
                                </td>
                                <td class="its-muted">{{#haspercent}}{{percent}}%{{/haspercent}}{{^haspercent}}–{{/haspercent}}</td>
                            </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>
            <button type="submit" class="btn btn-primary mt-3">{{#str}}saveattendance, local_itskills{{/str}}</button>
        </form>
    {{/hasrows}}
    {{^hasrows}}<div class="its-card its-empty">{{#str}}nolearners, local_itskills{{/str}}</div>{{/hasrows}}
</div>
