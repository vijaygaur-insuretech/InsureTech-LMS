{{!
    @template local_itskills/admin_skills

    Manage skills.

    Example context (json):
    { "actionurl": "#", "sesskey": "x", "skills": [], "hasskills": false, "courses": [] }
}}
<div class="its">
    <p class="its-muted">{{#str}}skills_intro, local_itskills{{/str}}</p>
    {{#skills}}
        <details class="its-card mb-2">
            <summary><strong>{{name}}</strong> <span class="its-muted">· {{coursenames}}</span></summary>
            <form method="post" action="{{actionurl}}" class="mt-3">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="{{id}}">
                <div class="row g-2">
                    <div class="col-md-5"><label class="form-label">{{#str}}name{{/str}}</label><input name="name" class="form-control" value="{{name}}" required></div>
                    <div class="col-md-2"><label class="form-label">{{#str}}order{{/str}}</label><input name="sortorder" type="number" class="form-control" value="{{sortorder}}"></div>
                    <div class="col-md-5"><label class="form-label">{{#str}}courses{{/str}}</label><select name="courses[]" class="form-select" multiple size="5">{{#courses}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/courses}}</select></div>
                </div>
                <div class="mt-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">{{#str}}savechanges{{/str}}</button>
                </div>
            </form>
            <form method="post" action="{{actionurl}}" class="mt-2">
                <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="{{id}}">
                <button type="submit" class="btn btn-link btn-sm text-danger p-0">{{#str}}delete{{/str}}</button>
            </form>
        </details>
    {{/skills}}
    <form method="post" action="{{actionurl}}" class="its-card mt-3">
        <h3 class="its-subtitle mt-0">{{#str}}addskill, local_itskills{{/str}}</h3>
        <input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="save">
        <div class="row g-2">
            <div class="col-md-5"><label class="form-label">{{#str}}name{{/str}}</label><input name="name" class="form-control" placeholder="AWS" required></div>
            <div class="col-md-2"><label class="form-label">{{#str}}order{{/str}}</label><input name="sortorder" type="number" class="form-control" value="0"></div>
            <div class="col-md-5"><label class="form-label">{{#str}}courses{{/str}}</label><select name="courses[]" class="form-select" multiple size="5">{{#courses}}<option value="{{id}}">{{name}}</option>{{/courses}}</select></div>
        </div>
        <button type="submit" class="btn btn-primary btn-sm mt-2">{{#str}}add{{/str}}</button>
    </form>
</div>
