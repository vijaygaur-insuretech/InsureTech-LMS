{{!
    @template local_itskills/mylive

    My live classes.

    Example context (json):
    { "upcoming": [{"title": "Kubernetes", "course": "DevOps", "day": "12", "month": "Oct", "when": "Mon 12 Oct, 7:00 PM",
        "duration": "90 mins", "live": false, "today": true, "canjoin": false, "joinurl": "#", "manageurl": ""}],
      "hasupcoming": true, "links": [], "haslinks": false }
}}
<div class="its its-mypage">
    <h3 class="its-subtitle mt-0">{{#str}}upcoming, local_itskills{{/str}}</h3>
    {{#hasupcoming}}
        <div class="its-rows">
            {{#upcoming}}
                <div class="its-row its-liverow{{#live}} is-live{{/live}}">
                    <span class="its-date"><b>{{day}}</b><small>{{month}}</small></span>
                    <span class="its-row-main">
                        <strong>{{title}}</strong>
                        <small>{{course}} · {{when}} · {{duration}}</small>
                    </span>
                    {{#live}}<span class="its-chip its-chip-live"><span class="it-live-dot"></span>{{#str}}livenow, local_itskills{{/str}}</span>{{/live}}
                    {{#today}}<span class="its-chip its-chip-pending">{{#str}}today{{/str}}</span>{{/today}}
                    {{#manageurl}}<a href="{{manageurl}}" class="btn btn-sm btn-outline-secondary">{{#str}}manage, local_itskills{{/str}}</a>{{/manageurl}}
                    {{#joinurl}}
                        {{#canjoin}}<a href="{{joinurl}}" target="_blank" rel="noopener" class="btn btn-sm btn-primary"><i class="icon fa fa-video" aria-hidden="true"></i>{{#str}}joinclass, local_itskills{{/str}}</a>{{/canjoin}}
                        {{^canjoin}}<span class="btn btn-sm btn-light disabled" title="{{#str}}joinopens, local_itskills{{/str}}"><i class="icon fa fa-clock" aria-hidden="true"></i>{{#str}}joinclass, local_itskills{{/str}}</span>{{/canjoin}}
                    {{/joinurl}}
                </div>
            {{/upcoming}}
        </div>
        <p class="its-muted mt-2">{{#str}}joinopens, local_itskills{{/str}}</p>
    {{/hasupcoming}}
    {{^hasupcoming}}
        <div class="its-card its-emptystate">
            <i class="icon fa fa-calendar-check m-0" aria-hidden="true"></i>
            <p>{{#str}}noupcoming, local_itskills{{/str}}</p>
        </div>
    {{/hasupcoming}}

    {{#haslinks}}
        <h3 class="its-subtitle">{{#str}}classlinks, local_itskills{{/str}}</h3>
        <div class="its-linkgrid">
            {{#links}}
                <div class="its-card its-linkcard">
                    <a href="{{courseurl}}" class="its-linkcard-course">{{course}}</a>
                    {{#schedule}}<span class="its-muted"><i class="icon fa fa-calendar" aria-hidden="true"></i>{{schedule}}</span>{{/schedule}}
                    <div class="its-linkcard-actions">
                        {{#link}}<a href="{{link}}" target="_blank" rel="noopener" class="btn btn-sm btn-primary"><i class="icon fa fa-video" aria-hidden="true"></i>{{#str}}joinclass, local_itskills{{/str}}</a>{{/link}}
                        {{#manageurl}}<a href="{{manageurl}}" class="btn btn-sm btn-outline-secondary">{{#str}}manage, local_itskills{{/str}}</a>{{/manageurl}}
                    </div>
                </div>
            {{/links}}
        </div>
    {{/haslinks}}
</div>
