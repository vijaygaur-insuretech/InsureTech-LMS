{{!
    @template local_itskills/admin_feedback

    Moderate feedback.

    Example context (json):
    { "rows": [], "hasrows": false }
}}
<div class="its">
    {{#hasrows}}
        <div class="its-card p-0">
            <table class="table mb-0 its-table">
                <thead><tr><th>{{#str}}learner, local_itskills{{/str}}</th><th>{{#str}}course{{/str}}</th><th>{{#str}}rating, local_itskills{{/str}}</th><th>{{#str}}comment, local_itskills{{/str}}</th><th>{{#str}}status, local_itskills{{/str}}</th><th></th></tr></thead>
                <tbody>
                    {{#rows}}
                        <tr>
                            <td>{{name}}<br><span class="its-muted">{{date}}</span></td>
                            <td>{{course}}</td>
                            <td class="its-stars-static">{{stars}}{{#trainerstars}}<br><span class="its-muted">{{#str}}trainer, local_itskills{{/str}}: {{trainerstars}}</span>{{/trainerstars}}</td>
                            <td>{{comment}}</td>
                            <td><span class="its-badge its-fb-{{status}}">{{statuslabel}}</span></td>
                            <td class="text-end text-nowrap">
                                {{^ispublished}}<a href="{{publishurl}}" class="btn btn-sm btn-primary">{{#str}}publish, local_itskills{{/str}}</a>{{/ispublished}}
                                {{#ispublished}}<a href="{{hideurl}}" class="btn btn-sm btn-outline-secondary">{{#str}}hide{{/str}}</a>{{/ispublished}}
                            </td>
                        </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
    {{/hasrows}}
    {{^hasrows}}<div class="its-card its-empty">{{#str}}nofeedback, local_itskills{{/str}}</div>{{/hasrows}}
</div>
