{{!
    @template local_itskills/verify

    Public certificate verification.

    Example context (json):
    { "actionurl": "#", "code": "", "result": null, "hasresult": false }
}}
<div class="its its-verify">
    <div class="its-card">
        <h1 class="its-title">{{#str}}verifycert, local_itskills{{/str}}</h1>
        <p class="its-muted">{{#str}}verify_intro, local_itskills{{/str}}</p>
        <form method="get" action="{{actionurl}}" class="it-search">
            <label for="its-code" class="visually-hidden">{{#str}}cert_id, local_itskills{{/str}}</label>
            <input type="text" id="its-code" name="code" value="{{code}}" class="form-control" placeholder="ITS-XXXX-XXXX" required>
            <button type="submit" class="btn btn-primary">{{#str}}verify, local_itskills{{/str}}</button>
        </form>
        {{#hasresult}}{{#result}}
            {{#valid}}
                <div class="its-verified">
                    <i class="icon fa fa-circle-check" aria-hidden="true"></i>
                    <div>
                        <strong>{{#str}}certvalid, local_itskills{{/str}}</strong>
                        <p class="mb-0">{{#str}}certvalid_text, local_itskills, {"student": {{#quote}}{{student}}{{/quote}}, "course": {{#quote}}{{course}}{{/quote}}, "date": {{#quote}}{{date}}{{/quote}} }{{/str}}</p>
                        <code>{{code}}</code>
                    </div>
                </div>
            {{/valid}}
            {{^valid}}<div class="alert alert-danger mt-3">{{#str}}certinvalid, local_itskills{{/str}}</div>{{/valid}}
        {{/result}}{{/hasresult}}
    </div>
</div>
